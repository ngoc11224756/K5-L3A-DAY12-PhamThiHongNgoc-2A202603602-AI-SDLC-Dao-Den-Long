{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-headless.mjs",
    "build:headless": "node scripts/build-headless.mjs",
    "start": "node dist/run.mjs",
    "preview": "vite preview",
    "headless": "node dist/headless.mjs",
    "bench": "node dist/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc --max-semi-space-size=2 dist/soak.mjs --seed 7 --nights 10 --out soak.json",
    "test": "npm run build:headless && node --test tests/*.test.mjs",
    "verify": "npm test && node scripts/verify-phase4.mjs"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
